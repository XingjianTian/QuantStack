# Private deployment values belong in .env. Never commit the real file.
# Local commands: uv run --env-file .env ...
QUANT_STACK_ROOT=.
QUANT_DATA_ROOT=${QUANT_STACK_ROOT}/.local-data
QUANT_EXPERIMENT_ROOT=${QUANT_DATA_ROOT}/experiments
QUANT_RUNTIME_ROOT=${QUANT_DATA_ROOT}/runtime
QUANT_PYTHON=python3
QUANT_LOG_LEVEL=INFO
QUANT_API_HOST=127.0.0.1
QUANT_API_PORT=8900
QUANT_API_KEY=
VIBE_API_AUTH_KEY=

# Browser origins share a parent domain, as required by the session gateway.
QUANT_PUBLIC_DOMAIN=example.com
QUANT_PUBLIC_PORT=11443
QUANT_PUBLIC_HOST=quant.${QUANT_PUBLIC_DOMAIN}
QUANT_VIBE_PUBLIC_HOST=vibe-trading.${QUANT_PUBLIC_DOMAIN}
QUANT_SCREENER_PUBLIC_HOST=stock-screener.${QUANT_PUBLIC_DOMAIN}
QUANT_NAUTILUS_PUBLIC_HOST=nautilus.${QUANT_PUBLIC_DOMAIN}
QUANT_CENTER_VIBE_URL=https://${QUANT_VIBE_PUBLIC_HOST}:${QUANT_PUBLIC_PORT}
QUANT_CENTER_SCREENER_URL=https://${QUANT_SCREENER_PUBLIC_HOST}:${QUANT_PUBLIC_PORT}
QUANT_CENTER_NAUTILUS_URL=https://${QUANT_NAUTILUS_PUBLIC_HOST}:${QUANT_PUBLIC_PORT}
QUANT_CENTER_WEB_HEALTH_URL=http://center-web:8080/healthz
QUANT_CENTER_VIBE_HEALTH_URL=http://vibe-web:8899/live
QUANT_CENTER_SCREENER_HEALTH_URL=http://frontend/
QUANT_CENTER_NAUTILUS_HEALTH_URL=http://nautilus-lab-web:8080/healthz
QUANT_SAMPLE_SITE_ORIGIN=https://${QUANT_PUBLIC_HOST}:${QUANT_PUBLIC_PORT}

# Loopback bindings are the default. Select the host privately in .env.
QUANT_BIND_ADDRESS=127.0.0.1
QUANT_GATEWAY_UPSTREAM_HOST=127.0.0.1
QUANT_API_PUBLISHED_PORT=18900
QUANT_CENTER_PUBLISHED_PORT=18920
QUANT_VIBE_PUBLISHED_PORT=18899
QUANT_SCREENER_PUBLISHED_PORT=18910
QUANT_NAUTILUS_PUBLISHED_PORT=18930
QUANT_LEARN_PUBLISHED_PORT=18081
QUANT_RAGFLOW_PUBLISHED_PORT=18082
QUANT_RAGGRAPH_PUBLISHED_PORT=18083
QUANT_SCREENER_NETWORK=quant-workspace_default
QUANT_SECRET_GID=1004
QUANT_API_KEY_FILE=./secrets/quant-api-key
QUANT_DOCKER_DATA_ROOT=./data
QUANT_VIBE_ENV_FILE=./secrets/vibe.env
OLLAMA_BASE_URL=http://host.docker.internal:11434
QUANT_YFINANCE_PROXY_URL=http://127.0.0.1:7890
QUANT_SCREENER_BASE_URL=http://127.0.0.1:18910
QUANT_US_INSTRUMENT_SNAPSHOT=${QUANT_STACK_ROOT}/src/quant_stack/data/providers/yfinance/us_equity_xnas_xnys_2026_08_27_v1.json

# Optional private adapters: keep credentials server-side.
SS_LEGACY_PG_HOST=
SS_LEGACY_PG_PORT=5432
SS_LEGACY_PG_DATABASE=
SS_LEGACY_PG_USER=
SS_LEGACY_PG_PASSWORD=
SS_QUANTSTACK_BASE_URL=
SS_QUANTSTACK_API_KEY=
QUANT_WORKSPACE_HTTP_PROXY=

# Development proxies read these on the Node server, never in browser code.
QUANT_WEB_DEV_HOST=127.0.0.1
QUANT_WEB_DEV_PORT=5178
QUANT_NAUTILUS_DEV_PORT=5187
QUANT_DEV_API_URL=http://127.0.0.1:8900
QUANT_DEV_BROKERAGE_URL=http://127.0.0.1:8917
