{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-stack.local/schemas/experiment_manifest/1.0.0",
  "title": "Experiment Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "created_at", "strategy_id",
    "strategy_version", "strategy_spec_sha256", "code_commit", "upstream_versions",
    "data_versions", "parameter_file", "result_file", "report_file", "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "experiment_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "strategy_id": {"type": "string"},
    "strategy_version": {"type": "string"},
    "strategy_spec_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "code_commit": {"type": "string"},
    "upstream_versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "data_versions": {"type": "array", "items": {"type": "object"}},
    "parameter_file": {"type": "string"},
    "result_file": {"type": "string"},
    "report_file": {"type": "string"},
    "status": {"enum": ["created", "running", "completed", "failed", "invalidated"]}
  }
}
