{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-stack.local/schemas/strategy_spec/1.0.0",
  "title": "Quant Stack Strategy Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "strategy_id", "name", "version", "owner", "status",
    "thesis", "market_scope", "data_requirements", "signal_sources",
    "entry_rules", "exit_rules", "position_rules", "risk_limits", "backtest",
    "implementation"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "strategy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "status": {"enum": ["research", "backtested", "paper", "live", "retired"]},
    "thesis": {"type": "string", "minLength": 1},
    "market_scope": {"type": "object"},
    "data_requirements": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "signal_sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "entry_rules": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "exit_rules": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "position_rules": {"type": "object"},
    "risk_limits": {"type": "object"},
    "backtest": {"type": "object"},
    "implementation": {"type": "object"},
    "tags": {"type": "array", "items": {"type": "string"}}
  }
}
