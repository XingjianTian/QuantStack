{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-stack.local/schemas/data/daily-tolerance-assessment/v1",
  "title": "QuantStack Daily Tolerance Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "market",
    "session",
    "snapshot_id",
    "quality_status",
    "repair_status",
    "gate_status",
    "freshness_status",
    "returned_ids",
    "explicit_omission_ids",
    "unresolved_ids",
    "unresolved_outcomes",
    "alerts",
    "hard_failures",
    "metrics"
  ],
  "allOf": [
    {
      "if": {
        "properties": {"quality_status": {"const": "complete"}},
        "required": ["quality_status"]
      },
      "then": {"properties": {"unresolved_ids": {"maxItems": 0}}}
    },
    {
      "if": {
        "properties": {"hard_failures": {"minItems": 1}},
        "required": ["hard_failures"]
      },
      "then": {
        "properties": {
          "quality_status": {"const": "blocked"},
          "gate_status": {"const": "blocked"}
        }
      }
    },
    {
      "if": {
        "properties": {"gate_status": {"const": "ready"}},
        "required": ["gate_status"]
      },
      "then": {
        "properties": {
          "quality_status": {"enum": ["complete", "usable_partial", "usable_partial_exception"]},
          "hard_failures": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "market",
        "session",
        "snapshot_id",
        "requested_count",
        "returned_count",
        "no_bar_count",
        "unresolved_count",
        "bar_coverage",
        "exact_closure",
        "ledger_closure",
        "critical_unresolved_count",
        "max_unresolved_concentration",
        "missing_weight_ratio",
        "max_consecutive_unresolved"
      ],
      "properties": {
        "schema_version": {"const": "quantstack.daily-tolerance-metrics.v1"},
        "market": {"type": "string", "minLength": 1},
        "session": {"type": "string", "format": "date"},
        "snapshot_id": {"type": "string", "minLength": 1},
        "requested_count": {"type": "integer", "minimum": 0},
        "returned_count": {"type": "integer", "minimum": 0},
        "no_bar_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of no_bar identities backed by explicit evidence; rejected no_bar claims remain unresolved."
        },
        "unresolved_count": {"type": "integer", "minimum": 0},
        "bar_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "exact_closure": {"type": "number", "minimum": 0, "maximum": 1},
        "ledger_closure": {"type": "number", "minimum": 0, "maximum": 1},
        "critical_unresolved_count": {"type": "integer", "minimum": 0},
        "max_unresolved_concentration": {"type": "number", "minimum": 0, "maximum": 1},
        "missing_weight_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "max_consecutive_unresolved": {"type": "integer", "minimum": 0}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "quantstack.daily-tolerance-assessment.v1"},
    "market": {"type": "string", "minLength": 1},
    "session": {"type": "string", "format": "date"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "quality_status": {
      "enum": ["complete", "usable_partial", "usable_partial_exception", "blocked"]
    },
    "repair_status": {"enum": ["none", "backfill_pending", "quarantined"]},
    "gate_status": {"enum": ["ready", "blocked"]},
    "freshness_status": {"enum": ["fresh", "stale"]},
    "returned_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "explicit_omission_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true,
      "description": "Only no_bar identities backed by explicit evidence."
    },
    "unresolved_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "unresolved_outcomes": {
      "type": "object",
      "additionalProperties": {
        "enum": ["provider_empty", "provider_error", "missing_outcome", "no_bar"]
      },
      "description": "Original unresolved claim. A no_bar value here is an unproven claim rejected from explicit_omission_ids."
    },
    "alerts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "hard_failures": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "metrics": {"$ref": "#/$defs/metrics"}
  }
}
