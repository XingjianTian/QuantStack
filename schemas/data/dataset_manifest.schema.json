{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-stack.local/schemas/data/dataset_manifest/1.3.0",
  "title": "QuantStack Data Layer Dataset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema_version",
    "dataset_id",
    "version",
    "layer",
    "kind",
    "market",
    "provider",
    "frequency",
    "schema_ref",
    "storage_uri",
    "created_at",
    "source_timestamp",
    "available_at",
    "available_at_policy",
    "revision_policy",
    "row_count",
    "sha256",
    "quality_status",
    "quality",
    "license_scope"
  ],
  "properties": {
    "manifest_schema_version": {"enum": ["1.0.0", "1.1.0", "1.2.0", "1.3.0"]},
    "dataset_id": {"type": "string"},
    "version": {"type": "string"},
    "layer": {"enum": ["raw", "normalized", "feature"]},
    "kind": {
      "enum": [
        "market_bars",
        "instruments",
        "fundamentals",
        "corporate_actions",
        "factor"
      ]
    },
    "market": {"enum": ["CN", "HK", "US"]},
    "provider": {"type": "string"},
    "provider_version": {"type": ["string", "null"]},
    "adapter_version": {"type": ["string", "null"]},
    "native_schema_version": {"type": ["string", "null"]},
    "frequency": {"type": "string"},
    "schema_ref": {"type": "string"},
    "storage_uri": {"type": "string", "pattern": "^quant-data://"},
    "created_at": {"type": "string", "format": "date-time"},
    "source_timestamp": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "available_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "available_at_policy": {"type": "string"},
    "revision_policy": {"enum": ["immutable", "append_only", "rebuildable"]},
    "row_count": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "quality_status": {"enum": ["passed", "warning", "failed"]},
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks", "failed_checks", "warnings"],
      "properties": {
        "status": {"enum": ["passed", "warning", "failed"]},
        "checks": {"type": "array", "items": {"type": "string"}},
        "failed_checks": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "report_uri": {
          "type": ["string", "null"],
          "pattern": "^quant-data://"
        }
      }
    },
    "license_scope": {"type": "string"},
    "source_url": {"type": "string"},
    "input_dataset_versions": {"type": "array", "items": {"type": "string"}},
    "raw_storage_uri": {
      "type": ["string", "null"],
      "pattern": "^quant-data://"
    },
    "job_id": {"type": ["string", "null"]},
    "calendar_evidence": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "source",
            "source_kind",
            "version",
            "market",
            "timezone",
            "open_time",
            "close_time",
            "supported_start",
            "supported_end",
            "confirmed_sessions",
            "confirmed_non_sessions",
            "observed_at"
          ],
          "properties": {
            "schema_version": {"enum": ["1.0.0", "1.1.0"]},
            "source": {"type": "string"},
            "source_kind": {
              "enum": ["exchange_announcement", "provider_observed"]
            },
            "version": {"type": "string"},
            "market": {"enum": ["CN", "HK", "US"]},
            "timezone": {"type": "string"},
            "open_time": {"type": "string", "format": "time"},
            "close_time": {"type": "string", "format": "time"},
            "supported_start": {"type": "string", "format": "date"},
            "supported_end": {"type": "string", "format": "date"},
            "confirmed_sessions": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "format": "date"}
            },
            "confirmed_non_sessions": {
              "type": "array",
              "items": {"type": "string", "format": "date"}
            },
            "observed_at": {"type": "string", "format": "date-time"},
            "exchanges": {
              "type": "array",
              "items": {"type": "string"}
            },
            "day_evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["trading_date", "state", "source_refs"],
                "properties": {
                  "trading_date": {"type": "string", "format": "date"},
                  "state": {
                    "enum": [
                      "session",
                      "weekend",
                      "holiday",
                      "temporary_closure",
                      "unknown"
                    ]
                  },
                  "source_refs": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string"}
                  }
                }
              }
            },
            "raw_evidence_uri": {
              "type": ["string", "null"],
              "pattern": "^quant-data://"
            },
            "raw_evidence_sha256": {
              "type": ["string", "null"],
              "pattern": "^[a-f0-9]{64}$"
            },
            "normalized_evidence_uri": {
              "type": ["string", "null"],
              "pattern": "^quant-data://"
            },
            "normalized_evidence_sha256": {
              "type": ["string", "null"],
              "pattern": "^[a-f0-9]{64}$"
            },
            "update_policy": {"const": "new_version"}
          }
        }
      ]
    },
    "market_state_sample": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "version",
            "finite_sample",
            "as_of",
            "evidence",
            "raw_evidence_uri",
            "raw_evidence_sha256",
            "update_policy"
          ],
          "properties": {
            "schema_version": {"const": "1.0.0"},
            "version": {"type": "string"},
            "finite_sample": {"const": true},
            "as_of": {"type": "string", "format": "date-time"},
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "evidence_id",
                  "instrument_id",
                  "exchange",
                  "state",
                  "status",
                  "effective_from",
                  "effective_to",
                  "observed_at",
                  "source_kind",
                  "source_url",
                  "source_title",
                  "limitations"
                ],
                "properties": {
                  "evidence_id": {"type": "string"},
                  "instrument_id": {"type": "string"},
                  "exchange": {"type": "string"},
                  "state": {
                    "enum": [
                      "normal",
                      "risk_warning",
                      "suspended",
                      "zero_volume",
                      "recent_listing",
                      "short_history",
                      "delisted",
                      "inactive",
                      "code_change"
                    ]
                  },
                  "status": {
                    "enum": ["verified", "partial", "unavailable", "blocked"]
                  },
                  "effective_from": {"type": ["string", "null"], "format": "date"},
                  "effective_to": {"type": ["string", "null"], "format": "date"},
                  "observed_at": {"type": "string", "format": "date-time"},
                  "source_kind": {
                    "enum": [
                      "exchange_announcement",
                      "provider_observed",
                      "blocked_assessment"
                    ]
                  },
                  "source_url": {"type": "string"},
                  "source_title": {"type": "string"},
                  "limitations": {
                    "type": "array",
                    "items": {"type": "string"}
                  }
                }
              }
            },
            "raw_evidence_uri": {"type": "string", "pattern": "^quant-data://"},
            "raw_evidence_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "update_policy": {"const": "new_version"}
          }
        }
      ]
    }
  }
}
