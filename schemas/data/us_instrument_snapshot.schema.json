{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-stack.local/schemas/data/us-instrument-snapshot/1.0.0",
  "title": "QuantStack US Instrument Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "as_of", "source", "update_policy", "instruments"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "source": {"const": "curated_research_snapshot"},
    "update_policy": {"const": "new_version"},
    "membership_basis": {
      "enum": [
        "curated_research",
        "current_sp500_constituents_not_point_in_time",
        "current_xnas_xnys_listings_not_point_in_time",
        "recovery_subset_of_versioned_snapshot"
      ]
    },
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "excluded_source_symbols": {"type": "array", "items": {"type": "string"}},
    "instruments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instrument_id", "symbol", "canonical_venue", "provider_symbol", "status", "currency", "timezone"],
        "properties": {
          "instrument_id": {"type": "string", "minLength": 3},
          "symbol": {"type": "string", "minLength": 1},
          "canonical_venue": {"enum": ["XNYS", "XNAS"]},
          "provider_symbol": {"type": "string", "minLength": 1},
          "source_symbol": {"type": ["string", "null"]},
          "name": {"type": ["string", "null"]},
          "asset_class": {"enum": ["equity", "etf"]},
          "listed_from": {"type": ["string", "null"], "format": "date"},
          "listed_to": {"type": ["string", "null"], "format": "date"},
          "status": {"enum": ["listed", "delisted", "unknown"]},
          "currency": {"const": "USD"},
          "timezone": {"const": "America/New_York"}
        }
      }
    }
  }
}
