FROM node:22-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS build

WORKDIR /app
COPY apps/quant-center/package.json apps/quant-center/package-lock.json ./
RUN npm ci
COPY apps/quant-center/ ./
RUN npm run build

FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10

COPY docker/quant-center/nginx.conf /etc/nginx/templates/default.conf.template
COPY docker/quant-center/15-load-quant-api-key.envsh /docker-entrypoint.d/15-load-quant-api-key.envsh
COPY --from=build /app/dist /usr/share/nginx/html

LABEL org.opencontainers.image.version="0.9.14"

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
