FROM ghcr.io/astral-sh/uv:0.9.28@sha256:59240a65d6b57e6c507429b45f01b8f2c7c0bbeee0fb697c41a39c6a8e3a4cfb AS uv
FROM python:3.12-slim-bookworm@sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b

COPY --from=uv /uv /uvx /bin/
WORKDIR /app

COPY pyproject.toml uv.lock README.md VERSION_LOCK.json ./
COPY src ./src
COPY configs ./configs
COPY schemas ./schemas
COPY strategies ./strategies
COPY datasets/catalog ./datasets/catalog
RUN uv sync --frozen --no-dev --extra nautilus --extra data

RUN useradd --create-home --shell /usr/sbin/nologin quant \
    && mkdir -p /quant-data/experiments \
    && chown -R quant:quant /app /quant-data

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    QUANT_STACK_ROOT=/app \
    QUANT_DATA_ROOT=/quant-data \
    QUANT_EXPERIMENT_ROOT=/quant-data/experiments \
    QUANT_API_HOST=0.0.0.0 \
    QUANT_API_PORT=8900

USER quant
EXPOSE 8900
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8900/health')" || exit 1

CMD ["quant-stack-api"]
