@@ -26,6 +26,20 @@ export const STREAMING_HISTORY_PAGE_DAYS = 400;
 export const STREAMING_HISTORY_PREFETCH_BARS = 50;
 const HISTORY_START_GAP_TOLERANCE_DAYS = 31;

+export const currentHistoryPage = (
+  endDate = new Date(),
+  pageDays = STREAMING_HISTORY_PAGE_DAYS,
+) => {
+  if (!Number.isInteger(pageDays) || pageDays < 1) return null;
+  const end = new Date(endDate);
+  if (Number.isNaN(end.getTime())) return null;
+  end.setUTCHours(0, 0, 0, 0);
+  const start = new Date(end);
+  start.setUTCDate(start.getUTCDate() - pageDays + 1);
+  const format = (value) => value.toISOString().slice(0, 10);
+  return { start: format(start), end: format(end) };
+};
+
 const TIMEFRAME_VISIBLE_BARS = {
   'five-day': 5,
   daily: 130,
