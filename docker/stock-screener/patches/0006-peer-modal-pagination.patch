@@ -0,0 +1,18 @@
+import { describe, expect, it } from 'vitest';
+
+import { paginatePeerRows } from './peerRows';
+
+describe('paginatePeerRows', () => {
+  const rows = Array.from({ length: 462 }, (_, index) => ({ symbol: `S${index}` }));
+
+  it('renders only the requested peer page', () => {
+    expect(paginatePeerRows(rows, 0, 50)).toHaveLength(50);
+    expect(paginatePeerRows(rows, 1, 50)[0].symbol).toBe('S50');
+    expect(paginatePeerRows(rows, 9, 50)).toHaveLength(12);
+  });
+
+  it('returns an empty page for invalid input', () => {
+    expect(paginatePeerRows(null, 0, 50)).toEqual([]);
+    expect(paginatePeerRows(rows, 0, 0)).toEqual([]);
+  });
+});
