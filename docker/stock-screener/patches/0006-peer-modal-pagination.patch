+++ b/frontend/src/components/Scan/peerRows.js
@@ -0,0 +1,6 @@
+export const paginatePeerRows = (rows, page, rowsPerPage) => {
+  if (!Array.isArray(rows) || rowsPerPage <= 0) return [];
+  const safePage = Math.max(0, Number.isFinite(page) ? page : 0);
+  const start = safePage * rowsPerPage;
+  return rows.slice(start, start + rowsPerPage);
+};
