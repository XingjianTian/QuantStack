+export const historyPageIsExhausted = (
+  points,
+  range,
+  gapToleranceDays = HISTORY_START_GAP_TOLERANCE_DAYS,
+) => {
+  if (!Array.isArray(points) || points.length === 0) return true;
+  if (!range?.start || !Number.isFinite(gapToleranceDays) || gapToleranceDays < 0) return false;
+  const firstKey = points
+    .map((point) => point?.time ?? point?.date)
+    .filter(Boolean)
+    .map(String)
+    .sort()[0];
+  const requestedStart = new Date(`${range.start}T00:00:00Z`);
+  const returnedStart = new Date(`${firstKey}T00:00:00Z`);
+  if (Number.isNaN(requestedStart.getTime()) || Number.isNaN(returnedStart.getTime())) return false;
+  const gapDays = (returnedStart.getTime() - requestedStart.getTime()) / 86_400_000;
+  return gapDays > gapToleranceDays;
+};
