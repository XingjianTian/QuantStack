@@ -0,0 +1,109 @@
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
+import { fireEvent, render, screen, waitFor } from '@testing-library/react';
+import { ThemeProvider, createTheme } from '@mui/material/styles';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+import CandlestickChart from './CandlestickChart';
+
+const chartHarness = vi.hoisted(() => ({
+  logicalRangeHandler: null,
+  fetchRange: vi.fn(),
+}));
+
+vi.mock('../../api/priceHistory', () => ({
+  fetchPriceHistory: vi.fn(async () => ([
+    { date: '2026-03-01', open: 10, high: 12, low: 9, close: 11, volume: 100 },
+    { date: '2026-03-02', open: 11, high: 13, low: 10, close: 12, volume: 120 },
+  ])),
+  fetchPriceHistoryRange: (...args) => chartHarness.fetchRange(...args),
+  fetchRSLine: vi.fn(async () => null),
+  priceHistoryKeys: {
+    symbol: (symbol, period) => ['priceHistory', symbol, period],
+    range: (symbol, start, end) => ['priceHistory', symbol, 'range', start, end],
+    rsLine: (symbol, period) => ['priceHistory', 'rsLine', symbol, period],
+  },
+  PRICE_HISTORY_STALE_TIME: 300000,
+}));
+
+vi.mock('./createPriceChartSeries', () => {
+  const series = () => ({
+    setData: vi.fn(),
+    barsInLogicalRange: vi.fn(() => ({ barsBefore: 20 })),
+    priceScale: () => ({ applyOptions: vi.fn() }),
+  });
+  const timeScale = {
+    fitContent: vi.fn(),
+    getVisibleRange: vi.fn(() => ({ from: '2026-03-01', to: '2026-03-02' })),
+    getVisibleLogicalRange: vi.fn(() => ({ from: 0, to: 1 })),
+    setVisibleRange: vi.fn(),
+    setVisibleLogicalRange: vi.fn(),
+    subscribeVisibleLogicalRangeChange: vi.fn((handler) => {
+      chartHarness.logicalRangeHandler = handler;
+    }),
+    unsubscribeVisibleLogicalRangeChange: vi.fn(),
+    subscribeVisibleTimeRangeChange: vi.fn(),
+    unsubscribeVisibleTimeRangeChange: vi.fn(),
+  };
+  return {
+    createPriceChartSeries: vi.fn(() => ({
+      chart: {
+        timeScale: () => timeScale,
+        subscribeCrosshairMove: vi.fn(),
+        applyOptions: vi.fn(),
+        resize: vi.fn(),
+        remove: vi.fn(),
+      },
+      volumeSeries: series(),
+      candlestickSeries: series(),
+      ema10Series: series(),
+      ema20Series: series(),
+      ema50Series: series(),
+      rsLineSeries: series(),
+      rsMarkers: { setMarkers: vi.fn() },
+    })),
+  };
+});
+
+const renderChart = () => {
+  const queryClient = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+  return render(
+    <ThemeProvider theme={createTheme({ palette: { mode: 'dark' } })}>
+      <QueryClientProvider client={queryClient}>
+        <CandlestickChart symbol="600000.SS" height={400} />
+      </QueryClientProvider>
+    </ThemeProvider>,
+  );
+};
+
+describe('CandlestickChart streaming history', () => {
+  beforeEach(() => {
+    chartHarness.logicalRangeHandler = null;
+    chartHarness.fetchRange.mockReset();
+    chartHarness.fetchRange.mockImplementation(() => new Promise(() => {}));
+    globalThis.ResizeObserver = class {
+      observe() {}
+      disconnect() {}
+    };
+  });
+
+  it('does not prefetch on mount and keeps only one older-page request in flight', async () => {
+    renderChart();
+
+    await waitFor(() => expect(chartHarness.logicalRangeHandler).toBeTypeOf('function'));
+    await screen.findByText('12.00');
+    chartHarness.logicalRangeHandler({ from: 0, to: 1 });
+    expect(chartHarness.fetchRange).not.toHaveBeenCalled();
+
+    fireEvent.wheel(screen.getByTestId('candlestick-chart-canvas'));
+    chartHarness.logicalRangeHandler({ from: -1, to: 1 });
+    chartHarness.logicalRangeHandler({ from: -2, to: 0 });
+
+    await waitFor(() => expect(chartHarness.fetchRange).toHaveBeenCalledTimes(1));
+    expect(chartHarness.fetchRange).toHaveBeenCalledWith(
+      '600000.SS',
+      '2025-01-25',
+      '2026-02-28',
+      expect.objectContaining({ signal: expect.any(AbortSignal) }),
+    );
+  });
+});
