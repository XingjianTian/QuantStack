+
+export const nextDailyHistoryPeriod = (period) => {
+  const index = DAILY_HISTORY_PERIODS.indexOf(period);
+  if (index < 0) return '2y';
+  return DAILY_HISTORY_PERIODS[Math.min(index + 1, DAILY_HISTORY_PERIODS.length - 1)];
+};
+
 export const isDailyTimeframe = (timeframe) => timeframe === 'daily';
 
