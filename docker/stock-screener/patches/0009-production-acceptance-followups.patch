   const shift = Math.sign(wheelDelta) * Math.max(1, span * Math.min(Math.abs(wheelDelta) / 800, 0.15));
-  return clampLogicalRange({ from: range.from + shift, to: range.to + shift }, barCount);
+  const next = clampLogicalRange({ from: range.from + shift, to: range.to + shift }, barCount);
+  if (!next) return null;
+  if (Math.abs(next.from - range.from) < 0.001 && Math.abs(next.to - range.to) < 0.001) {
+    return null;
+  }
+  return next;
+};
+
+export const chartWheelIntent = (event) => {
+  const horizontal = Math.abs(Number(event?.deltaX) || 0);
+  const vertical = Math.abs(Number(event?.deltaY) || 0);
+  if ((event?.ctrlKey || event?.metaKey) && vertical > horizontal * 1.5) return 'zoom';
+  return 'pan';
 };
