 };
 
+const DAILY_PERIOD_YEARS = { '2y': 2, '5y': 5, '10y': 10 };
+
+export const missingDailyHistoryRange = (period, earliestDate) => {
+  const years = DAILY_PERIOD_YEARS[period];
+  if (!years || !earliestDate) return null;
+  const earliest = new Date(`${earliestDate}T00:00:00Z`);
+  if (Number.isNaN(earliest.getTime())) return null;
+  const end = new Date(earliest);
+  end.setUTCDate(end.getUTCDate() - 1);
+  const start = new Date();
+  start.setUTCHours(0, 0, 0, 0);
+  start.setUTCFullYear(start.getUTCFullYear() - years);
+  const format = (value) => value.toISOString().slice(0, 10);
+  if (start > end) return null;
+  return { start: format(start), end: format(end) };
+};
+
+export const mergePriceHistory = (...segments) => {
+  const byDate = new Map();
+  segments.flat().forEach((point) => {
+    const key = point?.time ?? point?.date;
+    if (key) byDate.set(String(key), point);
+  });
+  return [...byDate.entries()]
+    .sort(([left], [right]) => left.localeCompare(right))
+    .map(([, point]) => point);
+};
