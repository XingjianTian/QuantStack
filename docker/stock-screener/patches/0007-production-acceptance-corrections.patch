--- a/frontend/src/components/Charts/chartTimeframes.js
+++ b/frontend/src/components/Charts/chartTimeframes.js
@@ -33,8 +33,23 @@ export const zoomedLogicalRange = (range, direction, barCount) => {
   const span = range.to - range.from;
   if (span <= 0) return null;
 
-  const maximum = Math.max(5, barCount);
-  const targetSpan = Math.min(maximum, Math.max(5, span * (direction === 'in' ? 0.8 : 1.25)));
+  const maximum = Math.max(4, barCount - 1);
+  const targetSpan = Math.min(maximum, Math.max(4, span * (direction === 'in' ? 0.8 : 1.25)));
   const center = (range.from + range.to) / 2;
-  return { from: center - targetSpan / 2, to: center + targetSpan / 2 };
+  return clampLogicalRange({ from: center - targetSpan / 2, to: center + targetSpan / 2 }, barCount);
 };
+
+export const clampLogicalRange = (range, barCount) => {
+  if (!range || barCount < 2) return null;
+  const lastIndex = barCount - 1;
+  const span = Math.min(lastIndex, Math.max(0, range.to - range.from));
+  const from = Math.min(lastIndex - span, Math.max(0, range.from));
+  return { from, to: from + span };
+};
+
+export const pannedLogicalRange = (range, wheelDelta, barCount) => {
+  if (!range || !Number.isFinite(wheelDelta) || wheelDelta === 0) return null;
+  const span = range.to - range.from;
+  const shift = Math.sign(wheelDelta) * Math.max(1, span * Math.min(Math.abs(wheelDelta) / 800, 0.15));
+  return clampLogicalRange({ from: range.from + shift, to: range.to + shift }, barCount);
+};
