new file mode 100644
--- /dev/null
+++ b/frontend/src/utils/symbolMarket.js
@@ -0,0 +1,13 @@
+const CN_SUFFIXES = ['.SS', '.SZ', '.BJ'];
+
+export const marketFromSymbol = (symbol) => {
+  const normalized = String(symbol || '').trim().toUpperCase();
+  if (CN_SUFFIXES.some((suffix) => normalized.endsWith(suffix))) return 'CN';
+  return 'US';
+};
+
+export const filterRowsForMarket = (rows, market) => (
+  !market ? (rows || []) : (rows || []).filter((row) => (
+    String(row?.market || marketFromSymbol(row?.symbol)).toUpperCase() === String(market).toUpperCase()
+  ))
+);
