@@ -0,0 +1,22 @@
+import { describe, expect, it } from 'vitest';
+
+import { filterRowsForMarket, marketFromSymbol } from './symbolMarket';
+
+describe('symbol market helpers', () => {
+  it('recognizes mainland suffixes and treats unsuffixed tickers as US', () => {
+    expect(marketFromSymbol('600519.SS')).toBe('CN');
+    expect(marketFromSymbol('000001.SZ')).toBe('CN');
+    expect(marketFromSymbol('920001.BJ')).toBe('CN');
+    expect(marketFromSymbol('AAPL')).toBe('US');
+  });
+
+  it('keeps only rows belonging to the selected market', () => {
+    const rows = [
+      { symbol: '600519.SS' },
+      { symbol: 'AAPL' },
+      { symbol: 'SPY', market: 'US' },
+    ];
+    expect(filterRowsForMarket(rows, 'CN').map((row) => row.symbol)).toEqual(['600519.SS']);
+    expect(filterRowsForMarket(rows, 'US').map((row) => row.symbol)).toEqual(['AAPL', 'SPY']);
+  });
+});
