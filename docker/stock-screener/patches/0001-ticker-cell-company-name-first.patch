@@ -0,0 +1,25 @@
+import '@testing-library/jest-dom/vitest';
+import { render } from '@testing-library/react';
+import { describe, expect, it } from 'vitest';
+
+import TickerCell from './TickerCell';
+
+describe('TickerCell downstream name-first hierarchy', () => {
+  it('renders the company name before the secondary ticker code', () => {
+    const { container } = render(
+      <TickerCell symbol="001258.SZ" companyName="立新能源" align="center" />
+    );
+
+    const labels = Array.from(container.querySelectorAll('span')).map((node) => node.textContent);
+    expect(labels).toEqual(['立新能源', '001258.SZ']);
+    expect(container.querySelector('span[title="立新能源"]')).toBeInTheDocument();
+    expect(container.querySelector('span[title="001258.SZ"]')).toBeInTheDocument();
+  });
+
+  it('keeps the ticker code as the primary label when no company name exists', () => {
+    const { container } = render(<TickerCell symbol="001258.SZ" />);
+
+    const labels = Array.from(container.querySelectorAll('span')).map((node) => node.textContent);
+    expect(labels).toEqual(['001258.SZ']);
+  });
+});
