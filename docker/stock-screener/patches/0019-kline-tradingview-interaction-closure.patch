+export const shiftedLogicalRangeAfterPrepend = (range, previousCandles, nextCandles) => {
+  if (
+    !range
+    || !Number.isFinite(range.from)
+    || !Number.isFinite(range.to)
+    || range.to <= range.from
+  ) return null;
+
+  const previousFirstTime = previousCandles?.[0]?.time;
+  const prependCount = previousFirstTime == null
+    ? 0
+    : Math.max(0, (nextCandles || []).findIndex((point) => point?.time === previousFirstTime));
+  return {
+    from: range.from + prependCount,
+    to: range.to + prependCount,
+  };
+};
