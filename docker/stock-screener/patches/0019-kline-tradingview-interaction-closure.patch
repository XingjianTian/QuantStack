 export const defaultShowRsLine = (symbol) => !/\.(SS|SZ)$/i.test(symbol || '');
 
+export const chartPinchZoomDirection = (event) => {
+  if (!event?.ctrlKey && !event?.metaKey) return null;
+  const horizontal = Math.abs(Number(event.deltaX) || 0);
+  const vertical = Number(event.deltaY) || 0;
+  if (vertical === 0 || Math.abs(vertical) <= horizontal) return null;
+  return vertical < 0 ? 'in' : 'out';
+};
+
 export const STREAMING_HISTORY_PAGE_DAYS = 400;
 export const STREAMING_HISTORY_PREFETCH_BARS = 50;
 
