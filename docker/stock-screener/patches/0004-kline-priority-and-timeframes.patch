@@ -0,0 +1,48 @@
+import { describe, expect, it } from 'vitest';
+import {
+  chartZoomDirection,
+  clearRsOverlayForTimeframe,
+  historyPeriodForTimeframe,
+  isDailyTimeframe,
+  zoomedLogicalRange,
+} from './chartTimeframes';
+
+describe('chart timeframe controls', () => {
+  it('loads only the history window needed by the selected view', () => {
+    expect(historyPeriodForTimeframe('five-day')).toBe('1mo');
+    expect(historyPeriodForTimeframe('daily')).toBe('6mo');
+    expect(historyPeriodForTimeframe('weekly')).toBe('5y');
+    expect(historyPeriodForTimeframe('monthly')).toBe('10y');
+    expect(historyPeriodForTimeframe('quarterly')).toBe('10y');
+    expect(historyPeriodForTimeframe('yearly')).toBe('10y');
+  });
+
+  it('keeps the RS overlay on the full daily view only', () => {
+    expect(isDailyTimeframe('five-day')).toBe(false);
+    expect(isDailyTimeframe('daily')).toBe(true);
+    expect(isDailyTimeframe('weekly')).toBe(false);
+  });
+
+  it('clears an existing RS overlay synchronously before a non-daily fit', () => {
+    const calls = [];
+    const series = { setData: (value) => calls.push(['series', value]) };
+    const markers = { setMarkers: (value) => calls.push(['markers', value]) };
+
+    expect(clearRsOverlayForTimeframe('five-day', series, markers)).toBe(true);
+    expect(calls).toEqual([['series', []], ['markers', []]]);
+    expect(clearRsOverlayForTimeframe('daily', series, markers)).toBe(false);
+    expect(calls).toHaveLength(2);
+  });
+
+  it('recognizes command/control plus and minus without stealing plain keys', () => {
+    expect(chartZoomDirection({ metaKey: true, ctrlKey: false, key: '=' })).toBe('in');
+    expect(chartZoomDirection({ metaKey: false, ctrlKey: true, key: '-' })).toBe('out');
+    expect(chartZoomDirection({ metaKey: false, ctrlKey: false, key: '+' })).toBeNull();
+  });
+
+  it('zooms around the current center and respects visible data bounds', () => {
+    expect(zoomedLogicalRange({ from: 0, to: 100 }, 'in', 200)).toEqual({ from: 10, to: 90 });
+    expect(zoomedLogicalRange({ from: 25, to: 45 }, 'out', 200)).toEqual({ from: 22.5, to: 47.5 });
+    expect(zoomedLogicalRange({ from: 0, to: 100 }, 'out', 110)).toEqual({ from: -5, to: 105 });
+  });
+});
