@@ -0,0 +1,45 @@
+import { describe, expect, it } from 'vitest';
+import { aggregateByTimeframe, transformToCandlestickData } from './candlestickData';
+
+const day = (date, open, high, low, close, volume = 10) => ({
+  date, open, high, low, close, volume,
+});
+
+const rows = [
+  day('2025-12-31', 8, 10, 7, 9, 5),
+  day('2026-01-02', 10, 13, 9, 12, 10),
+  day('2026-01-30', 12, 15, 11, 14, 20),
+  day('2026-02-02', 15, 17, 13, 16, 30),
+  day('2026-04-01', 20, 23, 19, 22, 40),
+];
+
+describe('candlestick timeframe aggregation', () => {
+  it('builds monthly OHLCV from the daily source rows', () => {
+    expect(aggregateByTimeframe(rows, 'monthly')).toEqual([
+      day('2025-12-31', 8, 10, 7, 9, 5),
+      day('2026-01-30', 10, 15, 9, 14, 30),
+      day('2026-02-02', 15, 17, 13, 16, 30),
+      day('2026-04-01', 20, 23, 19, 22, 40),
+    ]);
+  });
+
+  it('builds quarterly and yearly OHLCV without another provider dataset', () => {
+    expect(aggregateByTimeframe(rows, 'quarterly').slice(-2)).toEqual([
+      day('2026-02-02', 10, 17, 9, 16, 60),
+      day('2026-04-01', 20, 23, 19, 22, 40),
+    ]);
+    expect(aggregateByTimeframe(rows, 'yearly').slice(-1)).toEqual([
+      day('2026-04-01', 10, 23, 9, 22, 100),
+    ]);
+  });
+
+  it('renders the five-day preset from the latest five daily bars', () => {
+    const sevenDays = Array.from({ length: 7 }, (_, index) => (
+      day(`2026-01-${String(index + 1).padStart(2, '0')}`, index, index + 2, index, index + 1)
+    ));
+    const transformed = transformToCandlestickData(sevenDays, 'five-day');
+    expect(transformed.candlesticks).toHaveLength(5);
+    expect(transformed.candlesticks[0].time).toBe('2026-01-03');
+    expect(transformed.candlesticks[4].time).toBe('2026-01-07');
+  });
+});
