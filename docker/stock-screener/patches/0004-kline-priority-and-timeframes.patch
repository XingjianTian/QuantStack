@@ -0,0 +1,40 @@
+export const CHART_TIMEFRAMES = [
+  { value: 'five-day', label: '5 Days', historyPeriod: '1mo' },
+  { value: 'daily', label: 'Daily K', historyPeriod: '6mo' },
+  { value: 'weekly', label: 'Weekly K', historyPeriod: '5y' },
+  { value: 'monthly', label: 'Monthly K', historyPeriod: '10y' },
+  { value: 'quarterly', label: 'Quarterly K', historyPeriod: '10y' },
+  { value: 'yearly', label: 'Yearly K', historyPeriod: '10y' },
+];
+
+export const historyPeriodForTimeframe = (timeframe, fallback = '6mo') => (
+  CHART_TIMEFRAMES.find((candidate) => candidate.value === timeframe)?.historyPeriod
+  ?? fallback
+);
+
+export const isDailyTimeframe = (timeframe) => timeframe === 'daily';
+
+export const clearRsOverlayForTimeframe = (timeframe, series, markers) => {
+  if (isDailyTimeframe(timeframe)) return false;
+  series?.setData?.([]);
+  markers?.setMarkers?.([]);
+  return true;
+};
+
+export const chartZoomDirection = (event) => {
+  if (!(event.metaKey || event.ctrlKey)) return null;
+  if (event.key === '+' || event.key === '=') return 'in';
+  if (event.key === '-' || event.key === '_') return 'out';
+  return null;
+};
+
+export const zoomedLogicalRange = (range, direction, barCount) => {
+  if (!range || !Number.isFinite(range.from) || !Number.isFinite(range.to)) return null;
+  const span = range.to - range.from;
+  if (span <= 0) return null;
+
+  const maximum = Math.max(5, barCount);
+  const targetSpan = Math.min(maximum, Math.max(5, span * (direction === 'in' ? 0.8 : 1.25)));
+  const center = (range.from + range.to) / 2;
+  return { from: center - targetSpan / 2, to: center + targetSpan / 2 };
+};
diff --git a/frontend/src/components/Charts/chartTimeframes.test.js b/frontend/src/components/Charts/chartTimeframes.test.js
