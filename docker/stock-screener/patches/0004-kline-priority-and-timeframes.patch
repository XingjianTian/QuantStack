+import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
+import { fireEvent, render, screen } from '@testing-library/react';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+import ChartViewerModal from './ChartViewerModal';
+
+let currentSymbol = 'AAA';
+
+const prefetchPriceHistoryBatch = vi.fn();
+const prefetchFundamentalsBatch = vi.fn();
+
+vi.mock('../../hooks/useChartNavigation', () => ({
+  useChartNavigation: () => ({
+    currentIndex: currentSymbol === 'AAA' ? 0 : 1,
+    currentSymbol,
+    totalCount: 2,
+    goNext: vi.fn(),
+    goPrevious: vi.fn(),
+    goToIndex: vi.fn(),
+  }),
+}));
+
+vi.mock('../Charts/CandlestickChart', () => ({
+  default: ({ symbol, onDataReady }) => (
+    <button type="button" onClick={() => onDataReady(symbol)}>
+      ready-{symbol}
+    </button>
+  ),
+}));
+
+vi.mock('../../api/priceHistory', () => ({
+  prefetchPriceHistoryBatch: (...args) => prefetchPriceHistoryBatch(...args),
+}));
+
+vi.mock('../../api/stocks', () => ({
+  getStockFundamentals: vi.fn(async () => ({})),
+  prefetchFundamentalsBatch: (...args) => prefetchFundamentalsBatch(...args),
+}));
+
+vi.mock('../../api/scans', () => ({
+  getAllFilteredSymbols: vi.fn(async () => ['AAA', 'BBB']),
+  getSetupDetails: vi.fn(async () => null),
+  getSingleResult: vi.fn(async () => ({})),
+}));
+
+vi.mock('../../api/groups', () => ({
+  getGroupDetail: vi.fn(async () => ({})),
+}));
+
+const renderModal = (queryClient, open = true) => render(
+  <QueryClientProvider client={queryClient}>
+    <ChartViewerModal
+      open={open}
+      onClose={vi.fn()}
+      initialSymbol="AAA"
+      scanId="scan-1"
+      navigationSymbolsOverride={['AAA', 'BBB']}
+      currentPageResults={[
+        { symbol: 'AAA', market: 'CN' },
+        { symbol: 'BBB', market: 'CN' },
+      ]}
+    />
+  </QueryClientProvider>
+);
+
+describe('ChartViewerModal readiness lifecycle', () => {
+  beforeEach(() => {
+    currentSymbol = 'AAA';
+    prefetchPriceHistoryBatch.mockClear();
+    prefetchFundamentalsBatch.mockClear();
+  });
+
+  it('requires fresh readiness after closing and reopening the same symbol', () => {
+    const queryClient = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+    const view = renderModal(queryClient);
+
+    fireEvent.click(screen.getByRole('button', { name: 'ready-AAA' }));
+    expect(prefetchPriceHistoryBatch).toHaveBeenCalledTimes(1);
+
+    view.rerender(
+      <QueryClientProvider client={queryClient}>
+        <ChartViewerModal
+          open={false}
+          onClose={vi.fn()}
+          initialSymbol="AAA"
+          scanId="scan-1"
+          navigationSymbolsOverride={['AAA', 'BBB']}
+          currentPageResults={[]}
+        />
+      </QueryClientProvider>
+    );
+    view.rerender(
+      <QueryClientProvider client={queryClient}>
+        <ChartViewerModal
+          open
+          onClose={vi.fn()}
+          initialSymbol="AAA"
+          scanId="scan-1"
+          navigationSymbolsOverride={['AAA', 'BBB']}
+          currentPageResults={[]}
+        />
+      </QueryClientProvider>
+    );
+
+    expect(prefetchPriceHistoryBatch).toHaveBeenCalledTimes(1);
+    fireEvent.click(screen.getByRole('button', { name: 'ready-AAA' }));
+    expect(prefetchPriceHistoryBatch).toHaveBeenCalledTimes(2);
+  });
+
+  it('does not reuse readiness across an A to B to A cycle', () => {
+    const queryClient = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+    const view = renderModal(queryClient);
+
+    fireEvent.click(screen.getByRole('button', { name: 'ready-AAA' }));
+    expect(prefetchPriceHistoryBatch).toHaveBeenCalledTimes(1);
+
+    currentSymbol = 'BBB';
+    view.rerender(
+      <QueryClientProvider client={queryClient}>
+        <ChartViewerModal
+          open
+          onClose={vi.fn()}
+          initialSymbol="AAA"
+          scanId="scan-1"
+          navigationSymbolsOverride={['AAA', 'BBB']}
+          currentPageResults={[]}
+        />
+      </QueryClientProvider>
+    );
+    currentSymbol = 'AAA';
+    view.rerender(
+      <QueryClientProvider client={queryClient}>
+        <ChartViewerModal
+          open
+          onClose={vi.fn()}
+          initialSymbol="AAA"
+          scanId="scan-1"
+          navigationSymbolsOverride={['AAA', 'BBB']}
+          currentPageResults={[]}
+        />
+      </QueryClientProvider>
+    );
+
+    expect(prefetchPriceHistoryBatch).toHaveBeenCalledTimes(1);
+  });
+});
