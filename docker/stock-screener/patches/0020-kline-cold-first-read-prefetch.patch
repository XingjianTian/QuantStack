 export const STREAMING_HISTORY_PREFETCH_BARS = 50;
 
+export const historyPrefetchBarsForRange = (
+  range,
+  {
+    minimum = STREAMING_HISTORY_PREFETCH_BARS,
+    viewportMultiplier = 1.25,
+  } = {},
+) => {
+  if (
+    !range
+    || !Number.isFinite(range.from)
+    || !Number.isFinite(range.to)
+    || range.to <= range.from
+  ) return minimum;
+  return Math.max(minimum, Math.ceil((range.to - range.from) * viewportMultiplier));
+};
