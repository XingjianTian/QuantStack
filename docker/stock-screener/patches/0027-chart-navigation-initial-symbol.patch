+import { render, waitFor } from '@testing-library/react';
+import { useChartNavigation } from './useChartNavigation';
+
+describe('useChartNavigation', () => {
+  it('never exposes the first row before a non-first initial symbol', async () => {
+    const observedSymbols = [];
+
+    function Probe() {
+      const navigation = useChartNavigation(
+        ['688368.SS', '688209.SS', '688300.SS'],
+        '688300.SS',
+        true
+      );
+      observedSymbols.push(navigation.currentSymbol);
+      return <span>{navigation.currentSymbol}</span>;
+    }
+
+    const view = render(<Probe />);
+    await waitFor(() => expect(view.getByText('688300.SS')).toBeInTheDocument());
+    expect(observedSymbols).not.toContain('688368.SS');
+  });
+});
