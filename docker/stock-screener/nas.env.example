# Copy to the stock-screener checkout as .env.docker and keep it out of Git.
COMPOSE_PROJECT_NAME=quant-workspace
ENABLED_MARKETS=US,CN
SS_MARKET_JOBS_ENABLED=false
MARKET_DATA_SOURCE_MODE=github_first

BACKEND_IMAGE=ghcr.io/xang1234/stockscreenclaude-backend
FRONTEND_IMAGE=ghcr.io/xang1234/stockscreenclaude-frontend
APP_IMAGE_TAG=v1.4.0
QUANT_WORKSPACE_BACKEND_IMAGE_REF=personal/stock-screener-backend-downstream:1.4.0-quant-runtime.16
SS_SCAN_ANALYTICS_TIMEOUT_SECONDS=30
SS_SCAN_ANALYTICS_MAX_ATTEMPTS=1
QUANT_WORKSPACE_FRONTEND_IMAGE_REF=personal/stock-screener-frontend-zh:1.4.0-zh.59

# The upstream Compose expands FRONTEND_PORT as <host-spec>:80. Include the
# bind address here so it cannot silently publish on every interface.
FRONTEND_PORT=127.0.0.1:18910
CORS_ORIGINS=http://127.0.0.1:18910
CELERY_TIMEZONE=Asia/Shanghai
SERVER_AUTH_SECURE_COOKIE=false
# The public hostname is protected by OpenResty Basic Auth. Keep the upstream
# application login disabled so operators authenticate only once.
SERVER_AUTH_ENABLED=false
SERVER_EXPOSE_API_DOCS=false

# QuantStack ten-year qfq data is the default CN daily response path.
# Rollback: set SS_QUANTSTACK_READ_MODE=legacy and recreate the backend.
SS_QUANTSTACK_READ_MODE=quantstack_primary
SS_QUANTSTACK_PRIMARY_ENABLED=true
SS_QUANTSTACK_SHADOW_ENABLED=false
SS_QUANTSTACK_SHADOW_SAMPLE_RATE=0
SS_QUANTSTACK_SHADOW_ALLOWLIST=
SS_QUANTSTACK_SHADOW_MAX_WINDOW_DAYS=3650
SS_QUANTSTACK_BASE_URL=
SS_QUANTSTACK_API_KEY=
# The QuantStack API service must configure the same secret as QUANT_API_KEY;
# an unset server-side key makes all Batch routes fail closed with HTTP 503.
SS_QUANTSTACK_BARS_DATASET_ID=cn_equity_daily
SS_QUANTSTACK_DATASET_VERSION=daily-through-20260831.qfq-session-v1.materialized-range8-rg8192-v2
SS_QUANTSTACK_US_BARS_DATASET_ID=us_equity_total_return
SS_QUANTSTACK_US_INSTRUMENTS_DATASET_ID=instruments_us
SS_QUANTSTACK_US_INSTRUMENTS_DATASET_VERSION=latest
SS_QUANTSTACK_US_DATASET_VERSION=latest
SS_QUANTSTACK_US_DEFAULT=true
SS_QUANTSTACK_TIMEOUT_SECONDS=5
SS_QUANTSTACK_MAX_ATTEMPTS=2
SS_QUANTSTACK_CACHE_MAX_ENTRIES=2048
SS_QUANTSTACK_METADATA_TTL_SECONDS=30
SS_QUANTSTACK_SHADOW_QUEUE_SIZE=128
SS_QUANTSTACK_SHADOW_MAX_SYMBOLS_PER_TASK=100
SS_QUANTSTACK_SHADOW_MAX_LEGACY_ROWS_PER_TASK=100000
SS_QUANTSTACK_SHUTDOWN_TIMEOUT_SECONDS=1
SS_RUNTIME_ENV=production
SS_QUANTSTACK_ALLOW_CANDIDATE=false
SS_REQUIRED_SCAN_ANALYTICS_VERSION=quantstack.scan-analytics.v1
SS_QUANTSTACK_SHADOW_REPORT_ROOT=/app/data/quantstack-shadow-reports

# Optional: bridge a NAS loopback-only Mihomo HTTP proxy into this Compose
# network. Bind the relay to this stack's Docker network gateway, never 0.0.0.0.
# Leave both values empty when direct release downloads work normally.
PROXY_RELAY_BIND_ADDRESS=127.0.0.1
QUANT_WORKSPACE_HTTP_PROXY=

# Generate independent random values on the deployment host.
POSTGRES_DB=stockscanner
POSTGRES_USER=stockscanner
POSTGRES_PASSWORD=replace-with-random-value
SERVER_AUTH_PASSWORD=replace-with-random-value
SERVER_AUTH_SESSION_SECRET=replace-with-random-value

# Keep all third-party AI and search providers disabled in Phase 1.
GROQ_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
MINIMAX_API_KEY=
ZAI_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
LLM_FALLBACK_ENABLED=false
STATIC_EXPORT_ENABLED=false

WEB_CONCURRENCY=1
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
