ARG BUILDER_IMAGE=node:22-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2
ARG UPSTREAM_IMAGE=ghcr.io/xang1234/stockscreenclaude-frontend:v1.4.0@sha256:b738f2c18172b9c12d53e13ff92bf38f59145ec1154d9cc5a6fa98c4a4f1c23b
FROM ${BUILDER_IMAGE} AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Production is served behind the upstream nginx /api proxy. Keeping this
# relative also preserves the public Basic Auth origin and HTTPS scheme.
ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}

RUN npm run build

FROM ${UPSTREAM_IMAGE}

LABEL org.opencontainers.image.title="Quant Platform Stock Screener frontend downstream"
LABEL org.opencontainers.image.version="1.4.0-name-first.35"
LABEL org.opencontainers.image.source="https://github.com/xang1234/stock-screener"
LABEL quant.platform.upstream.commit="da4d01a83e420ac9c148ff4fe0260ee1e4228885"
LABEL quant.platform.patch="0001-ticker-cell-company-name-first.patch,0002-daily-snapshot-name-first-and-compact-health.patch,0003-chart-viewer-fit-available-height.patch,0004-kline-priority-and-timeframes.patch,0005-dual-market-production-closure.patch,0006-peer-modal-pagination.patch,0007-production-acceptance-corrections.patch,0008-complete-history-timeframes.patch,0009-production-acceptance-followups.patch,0010-browser-acceptance-corrections.patch,0011-market-switch-daily-tab.patch,0012-ss-home-and-incremental-history.patch,0013-cn-chart-primary-priority.patch,0014-cn-rs-on-demand.patch,0015-history-expansion-gesture.patch,0016-history-range-route.patch,0017-symbol-scoped-chart-instance.patch,0018-detail-chart-streaming-history.patch,0019-kline-tradingview-interaction-closure.patch,0020-kline-cold-first-read-prefetch.patch,0021-kline-eager-history-prefetch.patch,0022-kline-deep-first-request.patch,0023-stock-chart-parallel-dashboard.patch,0024-kline-empty-cold-range-guard.patch,0025-stock-chart-foreground-priority.patch,0026-chart-modal-eager-interaction.patch,0027-chart-navigation-initial-symbol.patch,0028-kline-progressive-first-paint.patch,0029-multitimeframe-shared-history.patch,0030-kline-history-foreground-priority.patch,0031-kline-viewport-paging.patch,0032-kline-background-preemption.patch,0033-kline-range-first-paint.patch,0034-kline-dual-market-loading-policy.patch"

# Reuse the pinned official runtime and nginx configuration; replace only the
# source-built, content-hashed frontend assets.
COPY --from=builder /app/dist/ /usr/share/nginx/html/

# Docker can assign a new address when the backend container is recreated.
# Resolve the service name per request instead of retaining nginx's startup IP.
RUN sed -i \
    -e '/server_name _;/a\\    resolver 127.0.0.11 valid=10s ipv6=off;\n    set $backend_upstream backend:8000;' \
    -e 's#proxy_pass http://backend:8000/api/v1/auth/login;#proxy_pass http://$backend_upstream/api/v1/auth/login;#' \
    -e 's#proxy_pass http://backend:8000/api/;#proxy_pass http://$backend_upstream$request_uri;#' \
    /etc/nginx/conf.d/default.conf
