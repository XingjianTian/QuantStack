{
  "schema_version": "1.0.0",
  "policy_id": "cn-provider-operational-safety-v1",
  "timezone": "Asia/Shanghai",
  "sources": {
    "baostock": {
      "provider_version": "0.9.3",
      "daily_request_hard_limit": 50000,
      "daily_request_limit": 49000,
      "batch_size_max": 50,
      "min_batch_interval_seconds": 30,
      "min_batch_interval_source": "operator override via QUANTSTACK_BAOSTOCK_MIN_BATCH_INTERVAL_SECONDS; provider official limits are only the daily request ceiling and the concurrent-connection ban, with no official minimum interval",
      "max_serial_batches_per_day": 2880,
      "history_request_interval_seconds": 0.05,
      "daily_incremental": {
        "batch_size": 500,
        "batch_interval_seconds": 5,
        "pacing_source": "fixed QuantStack daily policy approved 2026-08-10"
      },
      "concurrency": 1,
      "counted_operations": [
        "login",
        "query_history_k_data_plus",
        "query_stock_basic"
      ],
      "blacklist_error_codes": [
        "10001011"
      ],
      "on_blacklist": "stop_without_retry_and_wait_for_egress_recovery",
      "resume": "use_default_rate_limit_and_single_flight",
      "runtime_ledger": "<isolated-data-root>/control/baostock-request-budget.json"
    }
  }
}
